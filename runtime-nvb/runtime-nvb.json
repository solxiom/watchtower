{
  "groups": {},
  "handlers": [
    "./handlers/CoordinatorWatchTaskHandler.js",
    "./handlers/GitAcceptanceTaskHandler.js",
    "./handlers/IndexBuildTaskHandler.js",
    "./handlers/RuntimeSmokeTaskHandler.js",
    "./handlers/tmux/TmuxEffectTaskHandler.js"
  ],
  "tasks": {
    "wt:coordinator:poll-triggers": {
      "doc": {
        "summary": "Read one bounded page of durable watcher events from the lane coordinator journal.",
        "usage": "Internal Watchtower coordinator ingestion task."
      },
      "handle": {
        "args": [
          {
            "expected": null,
            "fromByteOffset": 0,
            "fromSequence": 0,
            "laneDir": "/unset",
            "limit": 128,
            "operation": "poll-triggers",
            "schemaVersion": 1
          }
        ],
        "handler": "CoordinatorWatchTaskHandler",
        "preferType": "async",
        "type": "auto"
      },
      "runnerOpts": {}
    },
    "wt:git:publish-commits": {
      "doc": {
        "summary": "Push one repository's verified accepted commit through the cataloged Git leaf.",
        "usage": "Internal Watchtower coordinator effect task."
      },
      "handle": {
        "args": [
          {
            "ref": "refs/heads/unset",
            "remote": "origin",
            "schemaVersion": 1,
            "sha": "0000000000000000000000000000000000000000",
            "targetId": "unset"
          }
        ],
        "handler": "GitAcceptanceTaskHandler",
        "preferType": "async",
        "type": "auto"
      },
      "runnerOpts": {}
    },
    "wt:git:record-acceptance": {
      "doc": {
        "summary": "Confirm the durable batch-accepted acceptance effect. Never touches Git.",
        "usage": "Internal Watchtower coordinator effect task."
      },
      "handle": {
        "args": [
          {
            "schemaVersion": 1,
            "targetId": "unset"
          }
        ],
        "handler": "GitAcceptanceTaskHandler",
        "preferType": "async",
        "type": "auto"
      },
      "runnerOpts": {}
    },
    "wt:index:apply": {
      "doc": {
        "summary": "Apply a validated sealed-pack or runtime index rebuild.",
        "usage": "Internal Watchtower index effect task."
      },
      "handle": {
        "args": [
          {
            "dryRun": false,
            "indexRoot": "/lane/coordinator/index/runtime",
            "laneDir": "/lane",
            "laneId": "lane",
            "runtime": true,
            "runtimeIndexes": [
              {
                "databasePath": "/lane/db",
                "journalPath": "/lane/journal"
              }
            ],
            "schemaVersion": 1
          }
        ],
        "handler": "IndexBuildTaskHandler",
        "preferType": "async",
        "type": "auto"
      },
      "runnerOpts": {}
    },
    "wt:index:build": {
      "doc": {
        "summary": "Build the sealed-pack or runtime derived index.",
        "usage": "Internal Watchtower index task."
      },
      "handle": {
        "args": [
          {
            "dryRun": true,
            "indexRoot": "/lane/coordinator/index/runtime",
            "laneDir": "/lane",
            "laneId": "lane",
            "runtime": true,
            "runtimeIndexes": [
              {
                "databasePath": "/lane/db",
                "journalPath": "/lane/journal"
              }
            ],
            "schemaVersion": 1
          }
        ],
        "handler": "IndexBuildTaskHandler",
        "preferType": "async",
        "type": "auto"
      },
      "runnerOpts": {}
    },
    "wt:runtime:smoke": {
      "doc": {
        "summary": "Verify that the packaged runtime TaskHandler emits a structured result.",
        "usage": "Internal Watchtower runtime smoke task."
      },
      "handle": {
        "args": [
          {
            "operation": "runtime-smoke",
            "schemaVersion": 1
          }
        ],
        "handler": "RuntimeSmokeTaskHandler",
        "preferType": "async",
        "type": "auto"
      },
      "runnerOpts": {}
    },
    "wt:tmux:effect": {
      "doc": {
        "summary": "Execute one closed tmux operation through the cataloged leaf.",
        "usage": "Internal Watchtower coordinator effect task."
      },
      "handle": {
        "args": [
          {
            "operation": "tmux-effect",
            "schemaVersion": 1
          }
        ],
        "handler": "TmuxEffectTaskHandler",
        "preferType": "async",
        "type": "auto"
      },
      "runnerOpts": {}
    }
  }
}
