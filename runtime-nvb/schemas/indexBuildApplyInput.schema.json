{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "watchtower://runtime/schemas/index-build-apply-input/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runtime", "dryRun", "laneDir", "laneId", "indexRoot"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runtime": {"type": "boolean"},
    "dryRun": {"const": false},
    "laneDir": {"type": "string", "minLength": 1},
    "packRoot": {"type": "string", "minLength": 1},
    "packPath": {"type": "string", "minLength": 1},
    "indexRoot": {"type": "string", "minLength": 1},
    "laneId": {"type": "string", "minLength": 1},
    "acceptedPack": {"$ref": "indexBuildInput.schema.json#/$defs/consumedPack"},
    "runtimeIndexes": {"type": "array", "items": {"$ref": "indexBuildInput.schema.json#/$defs/runtimeIndex"}, "minItems": 1}
  },
  "allOf": [
    {"if": {"properties": {"runtime": {"const": true}}}, "then": {"required": ["runtimeIndexes"], "not": {"anyOf": [{"required": ["packRoot"]}, {"required": ["packPath"]}, {"required": ["acceptedPack"]}]}}},
    {"if": {"properties": {"runtime": {"const": false}}}, "then": {"required": ["packRoot", "packPath", "acceptedPack"], "not": {"required": ["runtimeIndexes"]}}}
  ]
}
