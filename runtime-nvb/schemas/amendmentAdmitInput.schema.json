{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "watchtower://runtime/schemas/amendment-admit-input/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "laneDir", "laneId", "affectedWorktreeIds", "body", "authority"],
  "properties": {
    "schemaVersion": {"const": 1},
    "operation": {"const": "admit"},
    "laneDir": {"type": "string", "minLength": 1},
    "laneId": {"type": "string", "minLength": 1},
    "affectedWorktreeIds": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "body": {"$ref": "#/$defs/admitPackAmendmentBody"},
    "authority": {"$ref": "#/$defs/admissionAuthorityContext"}
  },
  "$defs": {
    "admitPackAmendmentBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amendmentRequestId", "blockerId", "resolutionId", "supersedesSeal", "candidateSeal",
        "reviewedCommit", "packAcceptanceRef", "specAuthoritySessionId"
      ],
      "properties": {
        "amendmentRequestId": {"type": "string", "minLength": 1},
        "blockerId": {"type": "string", "minLength": 1},
        "resolutionId": {"type": "string", "minLength": 1},
        "supersedesSeal": {"type": "string"},
        "candidateSeal": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "reviewedCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "packAcceptanceRef": {"type": "string", "minLength": 1},
        "specAuthoritySessionId": {"type": "string", "minLength": 1}
      }
    },
    "operatorSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "role"],
      "properties": {
        "sessionId": {"type": "string", "minLength": 1},
        "role": {"type": "string", "enum": ["operator", "pack-spec-authority"]}
      }
    },
    "admissionAuthorityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packActiveSeal"],
      "properties": {
        "operatorSession": {"$ref": "#/$defs/operatorSession"},
        "packAuthorSessionId": {"type": "string", "minLength": 1},
        "packActiveSeal": {"type": "string"}
      }
    }
  }
}
