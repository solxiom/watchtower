{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "watchtower://runtime/schemas/hold-place-input/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "laneDir", "laneId", "scope", "reason", "expiresAt", "origin"],
  "properties": {
    "schemaVersion": {"const": 1},
    "operation": {"const": "place"},
    "laneDir": {"type": "string", "minLength": 1},
    "laneId": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reason": {"type": "string", "minLength": 1},
    "expiresAt": {"type": "string", "minLength": 1},
    "origin": {
      "type": "string",
      "enum": ["operator", "coordinator-D1", "coordinator-D2", "coordinator-D3", "architect-advisor", "M0-safety", "M0-system"]
    }
  }
}
