{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "../dist",
    "rootDir": "..",
    "sourceMap": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "./catalog/*.nvb.json",
    "./catalog/capabilities/*.catalog.json",
    "./profiles/*.profile.json",
    "./schemas/*.schema.json",
    "./types/**/*.d.ts"
  ]
}
