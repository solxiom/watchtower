{
  "x-watchtower-fragment": {
    "schemaVersion": 1,
    "id": "watchtower.v1.lane-views",
    "includes": []
  },
  "$defs": {
    "laneStatus": {
      "type": "object",
      "required": [
        "lane",
        "repositories",
        "lifecycle",
        "health",
        "workerSessions",
        "watcher",
        "coordinator",
        "runtime"
      ],
      "properties": {
        "lane": {
          "type": "object",
          "required": [
            "id",
            "slug",
            "initiativeId",
            "kind",
            "controlHome"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "slug": {
              "type": "string"
            },
            "initiativeId": {
              "type": "string"
            },
            "kind": {
              "const": "implementation"
            },
            "controlHome": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "repositories": {
          "type": "array"
        },
        "lifecycle": {
          "type": "object",
          "required": [
            "status",
            "activeBatch"
          ],
          "properties": {
            "status": {
              "enum": [
                "bootstrap",
                "active",
                "paused",
                "complete",
                "unknown"
              ]
            },
            "activeBatch": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "health": {
          "type": "object",
          "required": [
            "status",
            "warnings"
          ],
          "properties": {
            "status": {
              "enum": [
                "ok",
                "attention",
                "complete",
                "invalid"
              ]
            },
            "warnings": {
              "type": "array"
            }
          },
          "additionalProperties": true
        },
        "workerSessions": {
          "type": "object"
        },
        "watcher": {
          "type": "object"
        },
        "coordinator": {
          "type": "object"
        },
        "runtime": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "resolvedConfig": {
      "type": "object",
      "required": [
        "laneId",
        "controlHome",
        "repositories",
        "laneDir",
        "runtimeRoot",
        "knowledgeRoot",
        "config",
        "redactedKeys"
      ],
      "properties": {
        "laneId": {
          "type": "string",
          "format": "uuid"
        },
        "controlHome": {
          "type": "string"
        },
        "repositories": {
          "type": "array"
        },
        "laneDir": {
          "type": "string"
        },
        "runtimeRoot": {
          "type": "string"
        },
        "knowledgeRoot": {
          "type": "string"
        },
        "config": {
          "type": "object"
        },
        "redactedKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
