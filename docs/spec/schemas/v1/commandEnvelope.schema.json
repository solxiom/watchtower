{
  "x-watchtower-fragment": {
    "schemaVersion": 1,
    "id": "watchtower.v1.command-envelope",
    "includes": []
  },
  "$defs": {
    "commandResult": {
      "type": "object",
      "required": [
        "schemaVersion",
        "command",
        "ok",
        "data"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "ok": {
          "const": true
        },
        "data": {}
      },
      "additionalProperties": false
    },
    "commandError": {
      "type": "object",
      "required": [
        "schemaVersion",
        "command",
        "ok",
        "error"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "exitCode"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]+$"
            },
            "message": {
              "type": "string"
            },
            "exitCode": {
              "enum": [
                1,
                2,
                3,
                4,
                5
              ]
            },
            "details": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": [
        "items",
        "limit",
        "nextCursor",
        "revision"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 200
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "additionalProperties": true
    },
    "laneListPage": {
      "$ref": "#/$defs/page"
    }
  }
}
