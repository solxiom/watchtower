{
  "x-watchtower-fragment": {
    "schemaVersion": 1,
    "id": "watchtower.v1.command-envelope",
    "includes": []
  },
  "$defs": {
    "commandResult": {
      "type": "object",
      "required": [
        "schemaVersion",
        "command",
        "ok",
        "data"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "ok": {
          "const": true
        },
        "data": {}
      },
      "additionalProperties": false
    },
    "commandError": {
      "type": "object",
      "required": [
        "schemaVersion",
        "command",
        "ok",
        "error"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "exitCode"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]+$"
            },
            "message": {
              "type": "string"
            },
            "exitCode": {
              "enum": [
                1,
                2,
                3,
                4,
                5
              ]
            },
            "details": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": [
        "items",
        "limit",
        "nextCursor",
        "revision"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 200
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "additionalProperties": true
    },
    "laneListPage": {
      "type": "object",
      "required": ["items", "limit", "nextCursor", "revision", "warnings", "diagnostics"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {"$ref": "#/$defs/laneListItem"}
        },
        "limit": {"type": "integer", "minimum": 1, "maximum": 200},
        "nextCursor": {"type": ["string", "null"]},
        "revision": {"$ref": "#/$defs/digest"},
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["laneId", "reason"],
            "properties": {
              "laneId": {"type": "string"},
              "reason": {"enum": ["PATH_MISSING", "LANE_JSON_MISSING", "BINDING_MISMATCH"]}
            },
            "additionalProperties": false
          }
        },
        "diagnostics": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": [
                "workspaceResolution", "relevantLaneCount", "matchedLaneCount", "pageItemCount",
                "warningCount", "conflictCount"
              ],
              "properties": {
                "workspaceResolution": {"enum": ["explicit", "git", "ancestor", "current-directory"]},
                "relevantLaneCount": {"type": "integer", "minimum": 0},
                "matchedLaneCount": {"type": "integer", "minimum": 0},
                "pageItemCount": {"type": "integer", "minimum": 0, "maximum": 200},
                "warningCount": {"type": "integer", "minimum": 0},
                "conflictCount": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "laneListItem": {
      "type": "object",
      "required": [
        "laneId", "slug", "initiativeId", "kind", "controlHome", "repositoryCount",
        "lifecycle", "activeBatch", "runtimeVersion", "conflictState", "conflicts"
      ],
      "properties": {
        "laneId": {"type": "string", "format": "uuid"},
        "slug": {"type": "string"},
        "initiativeId": {"type": "string"},
        "kind": {"const": "implementation"},
        "controlHome": {"type": "string"},
        "repositoryCount": {"type": "integer", "minimum": 1},
        "lifecycle": {"enum": ["bootstrap", "active", "paused", "complete", "unknown"]},
        "activeBatch": {"type": ["string", "null"]},
        "runtimeVersion": {"type": "string"},
        "conflictState": {"enum": ["none", "detected"]},
        "conflicts": {"type": "array", "items": {"enum": ["shared-write", "path-conflict", "branch-conflict"]}}
      },
      "additionalProperties": false
    }
  }
}
