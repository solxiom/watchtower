{
  "x-watchtower-fragment": {
    "schemaVersion": 1,
    "id": "watchtower.v1.reports",
    "includes": []
  },
  "$defs": {
    "doctorReport": {
      "type": "object",
      "required": [
        "schemaVersion",
        "lane",
        "checks",
        "summary"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "lane": {
          "type": "object",
          "required": [
            "id",
            "slug"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "slug": {
              "$ref": "#/$defs/id"
            }
          },
          "additionalProperties": true
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status",
              "message",
              "reason"
            ],
            "properties": {
              "id": {
                "enum": [
                  "lane-marker",
                  "lane-config",
                  "repository-bindings",
                  "repository-permissions",
                  "git-ignore-coverage"
                ]
              },
              "status": {
                "enum": [
                  "pass",
                  "warn",
                  "fail",
                  "skip"
                ]
              },
              "message": {
                "type": "string"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "summary": {
          "type": "object",
          "required": [
            "pass",
            "warn",
            "fail",
            "skip"
          ],
          "properties": {
            "pass": {"type": "integer", "minimum": 0},
            "warn": {"type": "integer", "minimum": 0},
            "fail": {"type": "integer", "minimum": 0},
            "skip": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "upgradePlan": {
      "type": "object",
      "required": [
        "from",
        "to",
        "applied",
        "changed",
        "unchanged",
        "preserved",
        "migrated",
        "conflicts"
      ],
      "properties": {
        "from": {
          "type": "object"
        },
        "to": {
          "type": "object"
        },
        "applied": {
          "type": "boolean"
        },
        "changed": {
          "type": "array"
        },
        "unchanged": {
          "type": "array"
        },
        "preserved": {
          "type": "array"
        },
        "migrated": {
          "type": "array"
        },
        "conflicts": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "versionReport": {
      "type": "object",
      "required": [
        "cliVersion",
        "runtimeVersion",
        "knowledgeVersion",
        "laneSchemaVersion"
      ],
      "properties": {
        "cliVersion": {
          "type": "string"
        },
        "runtimeVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledgeVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "laneSchemaVersion": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
