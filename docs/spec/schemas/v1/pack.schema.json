{
  "x-watchtower-fragment": {
    "schemaVersion": 1,
    "id": "watchtower.v1.pack",
    "includes": []
  },
  "$defs": {
    "implementationPack": {
      "type": "object",
      "required": [
        "schemaVersion",
        "packId",
        "initiativeId",
        "authoredByLaneId",
        "kind",
        "status",
        "packRepository",
        "repositories",
        "sourceBaselines",
        "acceptedInputs",
        "artifacts",
        "requirements",
        "batches"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "packId": {
          "$ref": "#/$defs/id"
        },
        "initiativeId": {
          "$ref": "#/$defs/id"
        },
        "authoredByLaneId": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "implementation"
        },
        "status": {
          "const": "accepted"
        },
        "packRepository": {
          "$ref": "#/$defs/id"
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repository"
          }
        },
        "sourceBaselines": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "revision",
              "dirty"
            ],
            "properties": {
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{7,64}$"
              },
              "dirty": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        },
        "acceptedInputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "repository",
              "path",
              "sha256",
              "acceptanceRef"
            ],
            "properties": {
              "repository": {
                "$ref": "#/$defs/id"
              },
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "sha256": {
                "$ref": "#/$defs/digest"
              },
              "acceptanceRef": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "additionalProperties": true
          }
        },
        "artifacts": {
          "type": "object",
          "required": [
            "readme",
            "traceability",
            "implementationMap",
            "qualityRules",
            "roadmap",
            "tracker",
            "acceptance",
            "seal"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "batches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/batch"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
