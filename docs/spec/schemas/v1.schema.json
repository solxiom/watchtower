          },
          "minItems": 1,
          "type": "array"
        },
        "generatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "manifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "packId": {
          "$ref": "#/$defs/id"
        },
        "schemaVersion": {
          "const": 1
        },
        "sealId": {
          "$ref": "#/$defs/digest"
        },
        "sourceBaselines": {
          "type": "object"
        }
      },
      "required": [
        "schemaVersion",
        "packId",
        "sealId",
        "manifestDigest",
        "acceptanceDigest",
        "sourceBaselines",
        "files",
        "generatedAt"
      ],
      "type": "object"
    },
    "laneListItem": {
      "additionalProperties": false,
      "properties": {
        "activeBatch": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflictState": {
          "enum": [
            "none",
            "detected"
          ]
        },
        "conflicts": {
          "items": {
            "enum": [
              "shared-write",
              "path-conflict",
              "branch-conflict"
