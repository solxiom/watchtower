            "status": {
              "enum": [
                "bootstrap",
                "active",
                "paused",
                "complete",
                "unknown"
              ]
            }
          },
          "required": [
            "status",
            "activeBatch"
          ],
          "type": "object"
        },
        "repositories": {
          "type": "array"
        },
        "runtime": {
          "type": "object"
        },
        "watcher": {
          "type": "object"
        },
        "workerSessions": {
          "type": "object"
        }
      },
      "required": [
        "lane",
        "repositories",
        "lifecycle",
        "health",
        "workerSessions",
        "watcher",
        "coordinator",
        "runtime"
      ],
      "type": "object"
    },
    "mutationResult": {
      "additionalProperties": true,
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "changed": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unchanged": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "warnings": {
          "items": {
            "additionalProperties": true,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "applied",
        "changed",
        "unchanged",
        "warnings"
      ],
      "type": "object"
    },
    "packAcceptance": {
      "additionalProperties": true,
      "properties": {
        "acceptedAt": {
          "format": "date-time",
          "type": "string"
        },
        "acceptedManifestDigest": {
          "$ref": "#/$defs/digest"
        },
