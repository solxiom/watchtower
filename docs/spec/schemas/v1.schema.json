              }
            },
            "required": [
              "id",
              "severity",
              "disposition"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "packId": {
          "$ref": "#/$defs/id"
        },
        "reviewSessionId": {
          "$ref": "#/$defs/id"
        },
        "reviewedCommit": {
          "pattern": "^[0-9a-f]{7,64}$",
          "type": "string"
        },
        "reviewerId": {
          "$ref": "#/$defs/id"
        },
        "schemaVersion": {
          "const": 1
        },
        "verdict": {
          "const": "accept"
