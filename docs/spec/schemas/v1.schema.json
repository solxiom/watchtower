      },
      "required": [
        "schemaVersion",
        "packId",
        "verdict",
        "reviewerId",
        "reviewSessionId",
        "acceptedManifestDigest",
        "findings",
        "reviewedCommit",
        "acceptedAt"
      ],
      "type": "object"
    },
    "page": {
      "additionalProperties": true,
      "properties": {
        "items": {
          "maxItems": 200,
          "type": "array"
        },
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "required": [
        "items",
        "limit",
        "nextCursor",
        "revision"
      ],
      "type": "object"
