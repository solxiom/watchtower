        "controlHome": {
          "type": "string"
        },
        "initiativeId": {
          "type": "string"
        },
        "kind": {
          "const": "implementation"
        },
        "laneId": {
          "format": "uuid",
          "type": "string"
        },
        "lifecycle": {
          "enum": [
            "bootstrap",
            "active",
            "paused",
            "complete",
            "unknown"
          ]
        },
        "repositoryCount": {
          "minimum": 1,
          "type": "integer"
        },
        "runtimeVersion": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        }
      },
      "required": [
        "laneId",
        "slug",
        "initiativeId",
        "kind",
        "controlHome",
        "repositoryCount",
        "lifecycle",
        "activeBatch",
        "runtimeVersion",
        "conflictState",
        "conflicts"
      ],
      "type": "object"
    },
    "laneListPage": {
      "additionalProperties": false,
      "properties": {
        "diagnostics": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": false,
              "properties": {
                "conflictCount": {
                  "minimum": 0,
                  "type": "integer"
                },
                "matchedLaneCount": {
                  "minimum": 0,
                  "type": "integer"
                },
                "pageItemCount": {
                  "maximum": 200,
                  "minimum": 0,
                  "type": "integer"
                },
                "relevantLaneCount": {
                  "minimum": 0,
                  "type": "integer"
                },
                "warningCount": {
                  "minimum": 0,
                  "type": "integer"
                },
                "workspaceResolution": {
                  "enum": [
                    "explicit",
                    "git",
                    "ancestor",
                    "current-directory"
                  ]
                }
              },
              "required": [
                "workspaceResolution",
                "relevantLaneCount",
                "matchedLaneCount",
                "pageItemCount",
                "warningCount",
                "conflictCount"
              ],
              "type": "object"
            }
          ]
        },
        "items": {
          "items": {
            "$ref": "#/$defs/laneListItem"
          },
          "maxItems": 200,
          "type": "array"
        },
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "$ref": "#/$defs/digest"
        },
        "warnings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "laneId": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "PATH_MISSING",
                  "LANE_JSON_MISSING",
                  "BINDING_MISMATCH"
                ]
              }
            },
            "required": [
              "laneId",
              "reason"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "items",
        "limit",
        "nextCursor",
        "revision",
        "warnings",
        "diagnostics"
      ],
      "type": "object"
    },
    "laneStatus": {
      "additionalProperties": true,
      "properties": {
        "coordinator": {
          "type": "object"
        },
        "health": {
          "additionalProperties": true,
          "properties": {
            "status": {
              "enum": [
                "ok",
                "attention",
                "complete",
                "invalid"
              ]
            },
            "warnings": {
              "type": "array"
            }
          },
          "required": [
            "status",
            "warnings"
          ],
          "type": "object"
        },
        "lane": {
          "additionalProperties": true,
          "properties": {
            "controlHome": {
              "type": "string"
            },
            "id": {
              "format": "uuid",
              "type": "string"
            },
            "initiativeId": {
              "type": "string"
            },
            "kind": {
              "const": "implementation"
            },
            "slug": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "slug",
            "initiativeId",
            "kind",
            "controlHome"
          ],
          "type": "object"
        },
        "lifecycle": {
          "additionalProperties": true,
          "properties": {
