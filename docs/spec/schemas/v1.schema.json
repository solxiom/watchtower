        },
        "candidates": {
          "type": "array"
        }
      },
      "required": [
        "candidates",
        "blocked"
      ],
      "type": "object"
    },
    "relativePath": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)[^\\\\\\u0000]+$",
      "type": "string"
    },
    "repository": {
      "additionalProperties": true,
      "properties": {
        "access": {
          "enum": [
