{
  "$defs": {
    "batch": {
      "additionalProperties": true,
      "properties": {
        "dependsOn": {
          "items": {
            "$ref": "#/$defs/id"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "implementationReasoning": {
          "enum": [
            "R1",
            "R2",
            "R3",
            "R4",
            "R5"
          ]
        },
        "primaryRepository": {
          "$ref": "#/$defs/id"
        },
        "proofClasses": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "repositories": {
          "items": {
            "$ref": "#/$defs/batchRepository"
          },
          "minItems": 1,
          "type": "array"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "reviewBrief": {
          "$ref": "#/$defs/relativePath"
        },
        "reviewReasoning": {
          "enum": [
            "R1",
            "R2",
            "R3",
            "R4",
            "R5"
          ]
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "workBrief": {
          "$ref": "#/$defs/relativePath"
        },
        "workload": {
          "enum": [
            "small",
            "medium",
            "large",
            "very-large"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "dependsOn",
        "primaryRepository",
        "workBrief",
        "reviewBrief",
        "requirements",
        "repositories",
        "implementationReasoning",
        "reviewReasoning",
        "workload",
        "proofClasses"
      ],
      "type": "object"
    },
    "batchRepository": {
      "additionalProperties": true,
      "properties": {
        "access": {
          "enum": [
            "read",
            "write"
          ]
        },
        "claimMode": {
          "enum": [
            "read",
            "shared-write",
            "exclusive-write"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "access",
        "paths",
        "claimMode"
      ],
      "type": "object"
    },
    "commandError": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "minLength": 1,
          "type": "string"
        },
        "error": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "pattern": "^[A-Z][A-Z0-9_]+$",
              "type": "string"
            },
            "details": {},
            "exitCode": {
              "enum": [
                1,
                2,
                3,
                4,
                5
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "exitCode"
          ],
          "type": "object"
        },
        "ok": {
          "const": false
        },
        "schemaVersion": {
          "const": 1
        }
      },
      "required": [
        "schemaVersion",
        "command",
        "ok",
        "error"
      ],
      "type": "object"
    },
    "commandResult": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "minLength": 1,
          "type": "string"
        },
        "data": {},
        "ok": {
          "const": true
        },
        "schemaVersion": {
          "const": 1
        }
      },
      "required": [
        "schemaVersion",
        "command",
        "ok",
        "data"
      ],
      "type": "object"
    },
    "coordinatorResult": {
      "additionalProperties": true,
      "properties": {
        "laneId": {
          "format": "uuid",
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "projectionRevision": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "required": [
        "laneId",
        "projectionRevision",
        "operation",
        "outcome"
      ],
      "type": "object"
    },
    "decisionProposal": {
      "additionalProperties": true,
      "properties": {
        "body": {
          "type": "object"
        },
        "cycleId": {
          "$ref": "#/$defs/id"
        },
        "evidenceRefs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "proposalId": {
          "$ref": "#/$defs/id"
        },
        "requestedEffects": {
          "items": {
            "additionalProperties": true,
            "properties": {
              "effect": {
                "enum": [
                  "dispatch-batch",
                  "open-correction",
                  "route-correction",
                  "reroute-endpoint",
                  "reconcile-projection",
                  "create-amendment-request",
                  "grant-session-budget",
                  "place-hold",
                  "release-hold",
                  "open-escalation"
                ]
              }
            },
            "required": [
              "effect"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "schemaVersion": {
          "const": 1
        },
        "snapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "type": {
          "enum": [
            "select-ready-batch",
            "classify-reject",
            "open-correction",
            "select-correction-route",
            "request-reroute",
            "propose-reconciliation",
            "request-pack-amendment",
            "grant-session-budget",
            "place-hold",
            "release-hold",
            "escalate"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "cycleId",
        "proposalId",
        "type",
        "snapshotDigest",
        "expiresAt",
        "evidenceRefs",
        "body",
        "requestedEffects"
      ],
      "type": "object"
    },
    "derivedStoreManifest": {
      "additionalProperties": true,
      "properties": {
        "backend": {
          "const": "sqlite"
        },
        "builtAt": {
          "format": "date-time",
          "type": "string"
        },
        "compilerVersion": {
          "minLength": 1,
          "type": "string"
        },
        "counts": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "databaseSchemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "laneId": {
          "format": "uuid",
          "type": "string"
        },
        "packSealId": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "schemaVersion": {
          "const": 1
        },
        "semanticRoot": {
          "$ref": "#/$defs/digest"
        },
        "source": {
          "additionalProperties": true,
          "properties": {
            "checkpoint": {
              "type": [
                "string",
                "integer"
              ]
            },
            "identity": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "identity",
            "checkpoint"
          ],
          "type": "object"
        },
        "storeKind": {
          "enum": [
            "pack",
            "runtime",
            "sessions"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "backend",
        "storeKind",
        "databaseSchemaVersion",
        "compilerVersion",
        "laneId",
        "source",
        "semanticRoot",
        "builtAt"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "doctorReport": {
      "additionalProperties": true,
      "properties": {
        "checks": {
          "items": {
            "additionalProperties": true,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "status": {
                "enum": [
                  "pass",
                  "warn",
                  "fail",
                  "skip"
                ]
              }
            },
            "required": [
              "id",
              "status"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "checks"
      ],
      "type": "object"
    },
    "durableEvent": {
      "additionalProperties": true,
      "properties": {
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "causationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "correlationId": {
          "$ref": "#/$defs/id"
        },
        "eventId": {
          "$ref": "#/$defs/id"
        },
        "laneId": {
          "format": "uuid",
          "type": "string"
        },
        "payload": {
          "type": "object"
        },
        "policyVersion": {
          "minLength": 1,
          "type": "string"
        },
        "producer": {
          "minLength": 1,
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "eventId",
        "type",
        "sequence",
        "at",
        "laneId",
        "producer",
        "correlationId",
        "causationId",
        "policyVersion",
        "payload"
      ],
      "type": "object"
    },
    "eventPage": {
      "$ref": "#/$defs/page"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "implementationPack": {
      "additionalProperties": true,
      "properties": {
        "acceptedInputs": {
          "items": {
            "additionalProperties": true,
            "properties": {
              "acceptanceRef": {
                "$ref": "#/$defs/relativePath"
              },
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "repository": {
                "$ref": "#/$defs/id"
              },
              "sha256": {
                "$ref": "#/$defs/digest"
              }
            },
            "required": [
              "repository",
              "path",
              "sha256",
              "acceptanceRef"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "artifacts": {
          "additionalProperties": {
            "$ref": "#/$defs/relativePath"
          },
          "required": [
            "readme",
            "traceability",
            "implementationMap",
            "qualityRules",
            "roadmap",
            "tracker",
            "acceptance",
            "seal"
          ],
          "type": "object"
        },
        "authoredByLaneId": {
          "format": "uuid",
          "type": "string"
        },
        "batches": {
          "items": {
            "$ref": "#/$defs/batch"
          },
          "minItems": 1,
          "type": "array"
        },
        "initiativeId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "implementation"
        },
        "packId": {
          "$ref": "#/$defs/id"
        },
        "packRepository": {
          "$ref": "#/$defs/id"
        },
        "repositories": {
          "items": {
            "$ref": "#/$defs/repository"
          },
          "minItems": 1,
          "type": "array"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/requirement"
          },
          "minItems": 1,
          "type": "array"
        },
        "schemaVersion": {
          "const": 1
        },
        "sourceBaselines": {
          "additionalProperties": {
            "additionalProperties": true,
            "properties": {
              "dirty": {
                "type": "boolean"
              },
              "revision": {
                "pattern": "^[0-9a-f]{7,64}$",
                "type": "string"
              }
            },
            "required": [
              "revision",
              "dirty"
            ],
            "type": "object"
          },
          "minProperties": 1,
          "type": "object"
        },
        "status": {
          "const": "accepted"
        }
      },
      "required": [
        "schemaVersion",
        "packId",
        "initiativeId",
        "authoredByLaneId",
        "kind",
        "status",
        "packRepository",
        "repositories",
        "sourceBaselines",
        "acceptedInputs",
        "artifacts",
        "requirements",
        "batches"
      ],
      "type": "object"
    },
    "implementationPackLock": {
      "additionalProperties": true,
