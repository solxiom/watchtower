{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "watchtower://schemas/index-build-authorization-capsule/v1",
  "title": "Coordinator index-build authorization capsule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "proposal", "currentState"],
  "properties": {
    "schemaVersion": {"const": 1},
    "proposal": {"$ref": "#/$defs/proposal"},
    "currentState": {"$ref": "#/$defs/validationContext"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true},
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "cycleId", "proposalId", "type", "snapshotDigest", "expiresAt", "evidenceRefs", "body", "requestedEffects"],
      "properties": {
        "schemaVersion": {"const": 1}, "cycleId": {"$ref": "#/$defs/text"}, "proposalId": {"$ref": "#/$defs/text"},
        "type": {"enum": ["select-ready-batch", "classify-reject", "open-correction", "select-correction-route", "request-reroute", "propose-reconciliation", "request-pack-amendment", "propose-specification-resolution", "admit-pack-amendment", "resume-specification-blocked-session", "grant-session-budget", "place-hold", "release-hold", "escalate"]},
        "snapshotDigest": {"$ref": "#/$defs/digest"}, "expiresAt": {"$ref": "#/$defs/date"}, "evidenceRefs": {"$ref": "#/$defs/strings"}, "rationale": {"$ref": "#/$defs/text"},
        "body": {"oneOf": [{"$ref": "#/$defs/selectReadyBody"}, {"$ref": "#/$defs/classifyRejectBody"}, {"$ref": "#/$defs/openCorrectionBody"}, {"$ref": "#/$defs/selectRouteBody"}, {"$ref": "#/$defs/rerouteBody"}, {"$ref": "#/$defs/reconciliationBody"}, {"$ref": "#/$defs/packAmendmentBody"}, {"$ref": "#/$defs/specResolutionBody"}, {"$ref": "#/$defs/admitAmendmentBody"}, {"$ref": "#/$defs/resumeBody"}, {"$ref": "#/$defs/budgetGrantBody"}, {"$ref": "#/$defs/placeHoldBody"}, {"$ref": "#/$defs/releaseHoldBody"}, {"$ref": "#/$defs/escalateBody"}]},
        "requestedEffects": {"type": "array", "items": {"type": "object", "required": ["effect"], "properties": {"effect": {"enum": ["dispatch-batch", "open-correction", "route-correction", "reroute-endpoint", "reconcile-projection", "rebuild-index", "create-amendment-request", "activate-pack-revision", "resume-blocked-session", "grant-session-budget", "place-hold", "release-hold", "open-escalation", "record-acceptance", "publish-commits"]}}, "additionalProperties": false}}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "select-ready-batch"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/selectReadyBody"}}}},
        {"if": {"properties": {"type": {"const": "classify-reject"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/classifyRejectBody"}}}},
        {"if": {"properties": {"type": {"const": "open-correction"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/openCorrectionBody"}}}},
        {"if": {"properties": {"type": {"const": "select-correction-route"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/selectRouteBody"}}}},
        {"if": {"properties": {"type": {"const": "request-reroute"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/rerouteBody"}}}},
        {"if": {"properties": {"type": {"const": "propose-reconciliation"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/reconciliationBody"}}}},
        {"if": {"properties": {"type": {"const": "request-pack-amendment"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/packAmendmentBody"}}}},
        {"if": {"properties": {"type": {"const": "propose-specification-resolution"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/specResolutionBody"}}}},
        {"if": {"properties": {"type": {"const": "admit-pack-amendment"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/admitAmendmentBody"}}}},
        {"if": {"properties": {"type": {"const": "resume-specification-blocked-session"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/resumeBody"}}}},
        {"if": {"properties": {"type": {"const": "grant-session-budget"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/budgetGrantBody"}}}},
        {"if": {"properties": {"type": {"const": "place-hold"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/placeHoldBody"}}}},
        {"if": {"properties": {"type": {"const": "release-hold"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/releaseHoldBody"}}}},
        {"if": {"properties": {"type": {"const": "escalate"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/escalateBody"}}}}
      ]
    },
    "closedBody": {"type": "object"},
    "selectReadyBody": {"type": "object", "additionalProperties": false, "required": ["batchId"], "properties": {"batchId": {"$ref": "#/$defs/text"}}},
    "classifyRejectBody": {"type": "object", "additionalProperties": false, "required": ["classification", "findingIds", "strategy", "targetBatch"], "properties": {"classification": {"$ref": "#/$defs/text"}, "findingIds": {"$ref": "#/$defs/strings"}, "strategy": {"$ref": "#/$defs/text"}, "targetBatch": {"$ref": "#/$defs/text"}}},
    "openCorrectionBody": {"type": "object", "additionalProperties": false, "required": ["batchId", "findingIds"], "properties": {"batchId": {"$ref": "#/$defs/text"}, "findingIds": {"$ref": "#/$defs/strings"}}},
    "selectRouteBody": {"type": "object", "additionalProperties": false, "required": ["batchId", "route"], "properties": {"batchId": {"$ref": "#/$defs/text"}, "route": {"$ref": "#/$defs/text"}}},
    "rerouteBody": {"type": "object", "additionalProperties": false, "required": ["fromEndpointId", "toEndpointId"], "properties": {"fromEndpointId": {"$ref": "#/$defs/text"}, "toEndpointId": {"$ref": "#/$defs/text"}}},
    "reconciliationBody": {"type": "object", "additionalProperties": false, "required": ["projectionId", "plan"], "properties": {"projectionId": {"$ref": "#/$defs/text"}, "plan": {"$ref": "#/$defs/text"}}},
    "packAmendmentBody": {"type": "object", "additionalProperties": false, "required": ["packId", "reason"], "properties": {"packId": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"}}},
    "specResolutionBody": {"type": "object", "additionalProperties": false, "required": ["resolutionId", "blockerId", "recommendedDecision", "affectedPaths", "requiresSpecAuthority"], "properties": {"resolutionId": {"$ref": "#/$defs/text"}, "blockerId": {"$ref": "#/$defs/text"}, "recommendedDecision": {"$ref": "#/$defs/text"}, "affectedPaths": {"$ref": "#/$defs/strings"}, "affectedRequirementIds": {"$ref": "#/$defs/strings"}, "alternatives": {"$ref": "#/$defs/strings"}, "rationale": {"$ref": "#/$defs/text"}, "impactDigest": {"$ref": "#/$defs/digest"}, "requiresSpecAuthority": {"const": true}}},
    "admitAmendmentBody": {"type": "object", "additionalProperties": false, "required": ["amendmentRequestId", "blockerId", "resolutionId", "supersedesSeal", "candidateSeal", "reviewedCommit", "packAcceptanceRef", "specAuthoritySessionId"], "properties": {"amendmentRequestId": {"$ref": "#/$defs/text"}, "blockerId": {"$ref": "#/$defs/text"}, "resolutionId": {"$ref": "#/$defs/text"}, "supersedesSeal": {"$ref": "#/$defs/digest"}, "candidateSeal": {"$ref": "#/$defs/digest"}, "reviewedCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "packAcceptanceRef": {"$ref": "#/$defs/text"}, "specAuthoritySessionId": {"$ref": "#/$defs/text"}}},
    "resumeBody": {"type": "object", "additionalProperties": false, "required": ["blockerId", "workerSessionId", "operatorSessionId", "worktreeId", "syncedRevision"], "properties": {"blockerId": {"$ref": "#/$defs/text"}, "workerSessionId": {"$ref": "#/$defs/text"}, "operatorSessionId": {"$ref": "#/$defs/text"}, "worktreeId": {"$ref": "#/$defs/text"}, "syncedRevision": {"$ref": "#/$defs/text"}}},
    "budgetGrantBody": {"type": "object", "additionalProperties": false, "required": ["sessionId", "grantTokens", "reason"], "properties": {"sessionId": {"$ref": "#/$defs/text"}, "grantTokens": {"minimum": 1, "type": "integer"}, "reason": {"$ref": "#/$defs/text"}}},
    "placeHoldBody": {"type": "object", "additionalProperties": false, "required": ["scope", "reason", "expiresAt"], "properties": {"scope": {"$ref": "#/$defs/strings"}, "reason": {"$ref": "#/$defs/text"}, "expiresAt": {"$ref": "#/$defs/date"}}},
    "releaseHoldBody": {"type": "object", "additionalProperties": false, "required": ["holdId"], "properties": {"holdId": {"$ref": "#/$defs/text"}}},
    "escalateBody": {"type": "object", "additionalProperties": false, "required": ["reason", "profile"], "properties": {"reason": {"$ref": "#/$defs/text"}, "profile": {"$ref": "#/$defs/text"}}},
    "batch": {"type": "object", "additionalProperties": false, "required": ["batchId", "status"], "properties": {"batchId": {"$ref": "#/$defs/text"}, "status": {"$ref": "#/$defs/text"}}},
    "laneState": {"type": "object", "additionalProperties": false, "required": ["snapshotDigest", "batches"], "properties": {"snapshotDigest": {"$ref": "#/$defs/digest"}, "batches": {"type": "object", "additionalProperties": {"$ref": "#/$defs/batch"}}}},
    "envelope": {"type": "object", "additionalProperties": false, "required": ["permittedProposalTypes", "evidenceRefs", "packSealId", "manifestDigest", "endpointCapabilityClass"], "properties": {"permittedProposalTypes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "evidenceRefs": {"$ref": "#/$defs/strings"}, "packSealId": {"$ref": "#/$defs/text"}, "manifestDigest": {"$ref": "#/$defs/digest"}, "endpointCapabilityClass": {"pattern": "^C[1-5]$", "type": "string"}}},
    "packIndex": {"type": "object", "additionalProperties": false, "required": ["packSealId", "activeSeal", "manifestDigest"], "properties": {"packSealId": {"$ref": "#/$defs/text"}, "activeSeal": {"$ref": "#/$defs/text"}, "manifestDigest": {"$ref": "#/$defs/digest"}}},
    "journal": {"type": "object", "additionalProperties": false, "required": ["completedIdempotencyKeys"], "properties": {"completedIdempotencyKeys": {"$ref": "#/$defs/strings"}}},
    "operator": {"type": "object", "additionalProperties": false, "required": ["sessionId", "role", "confirmedProposalIds"], "properties": {"sessionId": {"$ref": "#/$defs/text"}, "role": {"enum": ["operator", "pack-spec-authority"]}, "confirmedProposalIds": {"$ref": "#/$defs/strings"}}},
    "claim": {"type": "object", "additionalProperties": false, "required": ["claimId", "targetIds"], "properties": {"claimId": {"$ref": "#/$defs/text"}, "targetIds": {"$ref": "#/$defs/strings"}}},
    "hold": {"type": "object", "additionalProperties": false, "required": ["holdId", "scope", "status"], "properties": {"holdId": {"$ref": "#/$defs/text"}, "scope": {"$ref": "#/$defs/strings"}, "status": {"enum": ["active", "expired"]}}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["laneWideGrantedTokens", "laneWideCeilingTokens", "protectedReserveTokens"], "properties": {"laneWideGrantedTokens": {"minimum": 0, "type": "integer"}, "laneWideCeilingTokens": {"minimum": 0, "type": "integer"}, "protectedReserveTokens": {"minimum": 0, "type": "integer"}}},
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["endpointId", "capacityPoolId"], "properties": {"endpointId": {"$ref": "#/$defs/text"}, "capacityPoolId": {"$ref": "#/$defs/text"}}},
    "amendment": {"type": "object", "additionalProperties": false, "required": ["amendmentRequestId", "blockerId", "resolutionId", "supersedesSeal", "candidateSeal", "parentReviewedCommit", "newReviewedCommit", "packAcceptanceRef", "reviewerSessionId", "authorSessionId", "committed", "verdict", "reviewerRole", "independent", "changedPaths", "changedRequirementIds", "impactDigest", "sealAlgorithm", "sealVersion"], "properties": {"amendmentRequestId": {"$ref": "#/$defs/text"}, "blockerId": {"$ref": "#/$defs/text"}, "resolutionId": {"$ref": "#/$defs/text"}, "supersedesSeal": {"$ref": "#/$defs/text"}, "candidateSeal": {"$ref": "#/$defs/text"}, "parentReviewedCommit": {"$ref": "#/$defs/text"}, "newReviewedCommit": {"$ref": "#/$defs/text"}, "packAcceptanceRef": {"$ref": "#/$defs/text"}, "reviewerSessionId": {"$ref": "#/$defs/text"}, "authorSessionId": {"$ref": "#/$defs/text"}, "committed": {"const": true}, "verdict": {"const": "accept"}, "reviewerRole": {"const": "reviewer"}, "independent": {"const": true}, "changedPaths": {"$ref": "#/$defs/strings"}, "changedRequirementIds": {"$ref": "#/$defs/strings"}, "impactDigest": {"$ref": "#/$defs/text"}, "sealAlgorithm": {"$ref": "#/$defs/text"}, "sealVersion": {"$ref": "#/$defs/text"}}},
    "revision": {"type": "object", "additionalProperties": false, "required": ["blockerId", "activeSeal", "requiredCommit"], "properties": {"blockerId": {"$ref": "#/$defs/text"}, "activeSeal": {"$ref": "#/$defs/text"}, "requiredCommit": {"$ref": "#/$defs/text"}}},
    "sync": {"type": "object", "additionalProperties": false, "required": ["worktreeId", "status", "syncedRevision"], "properties": {"worktreeId": {"$ref": "#/$defs/text"}, "status": {"enum": ["synchronized", "stale"]}, "syncedRevision": {"$ref": "#/$defs/text"}}},
    "assignment": {"type": "object", "additionalProperties": false, "required": ["blockerId", "workerSessionId", "operatorSessionId", "worktreeId", "claimIds"], "properties": {"blockerId": {"$ref": "#/$defs/text"}, "workerSessionId": {"$ref": "#/$defs/text"}, "operatorSessionId": {"$ref": "#/$defs/text"}, "worktreeId": {"$ref": "#/$defs/text"}, "claimIds": {"$ref": "#/$defs/strings"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["repository", "path", "digest", "verdict", "reviewerSessionId"], "properties": {"repository": {"$ref": "#/$defs/text"}, "path": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/digest"}, "verdict": {"const": "accept"}, "reviewerSessionId": {"$ref": "#/$defs/text"}}},
    "currentPack": {"type": "object", "additionalProperties": false, "required": ["packSealId", "manifestDigest", "compilerVersion"], "properties": {"packSealId": {"$ref": "#/$defs/text"}, "manifestDigest": {"$ref": "#/$defs/digest"}, "compilerVersion": {"$ref": "#/$defs/text"}}},
    "predecessor": {"type": "object", "additionalProperties": false, "required": ["index", "projections"], "properties": {"index": {"type": "object", "additionalProperties": false, "required": ["state", "indexId", "laneId", "revision", "packIndex", "acceptance"], "properties": {"state": {"const": "accepted"}, "indexId": {"$ref": "#/$defs/text"}, "laneId": {"$ref": "#/$defs/text"}, "revision": {"minimum": 1, "type": "integer"}, "packIndex": {"$ref": "#/$defs/currentPack"}, "acceptance": {"$ref": "#/$defs/provenance"}}}, "projections": {"type": "object", "additionalProperties": false, "required": ["state", "laneId", "revision", "journalIdentity", "checkpointDigest", "acceptance"], "properties": {"state": {"const": "accepted"}, "laneId": {"$ref": "#/$defs/text"}, "revision": {"minimum": 1, "type": "integer"}, "journalIdentity": {"$ref": "#/$defs/text"}, "checkpointDigest": {"$ref": "#/$defs/digest"}, "acceptance": {"$ref": "#/$defs/provenance"}}}}},
    "currentPredecessor": {"type": "object", "additionalProperties": false, "required": ["index", "projections"], "properties": {"index": {"type": "object", "additionalProperties": false, "required": ["state", "indexId", "laneId", "revision", "packIndex", "acceptance"], "properties": {"state": {"const": "accepted"}, "indexId": {"$ref": "#/$defs/text"}, "laneId": {"$ref": "#/$defs/text"}, "revision": {"minimum": 1, "type": "integer"}, "packIndex": {"$ref": "#/$defs/currentPack"}, "acceptance": {"$ref": "#/$defs/reference"}}}, "projections": {"type": "object", "additionalProperties": false, "required": ["state", "laneId", "revision", "journalIdentity", "checkpointDigest", "acceptance"], "properties": {"state": {"const": "accepted"}, "laneId": {"$ref": "#/$defs/text"}, "revision": {"minimum": 1, "type": "integer"}, "journalIdentity": {"$ref": "#/$defs/text"}, "checkpointDigest": {"$ref": "#/$defs/digest"}, "acceptance": {"$ref": "#/$defs/reference"}}}}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["repository", "path", "digest"], "properties": {"repository": {"$ref": "#/$defs/text"}, "path": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/digest"}}},
    "acceptanceRecord": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "repository", "path", "digest", "committed", "verdict", "reviewerRole", "independent", "reviewerSessionId", "subjectKind", "subjectId", "subjectRevision", "subjectDigest", "packSealId", "journalIdentity"], "properties": {"schemaVersion": {"const": 1}, "repository": {"$ref": "#/$defs/text"}, "path": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/digest"}, "committed": {"const": true}, "verdict": {"const": "accept"}, "reviewerRole": {"const": "reviewer"}, "independent": {"const": true}, "reviewerSessionId": {"$ref": "#/$defs/text"}, "subjectKind": {"enum": ["index", "projection"]}, "subjectId": {"$ref": "#/$defs/text"}, "subjectRevision": {"minimum": 1, "type": "integer"}, "subjectDigest": {"$ref": "#/$defs/digest"}, "packSealId": {"$ref": "#/$defs/text"}, "journalIdentity": {"type": ["string", "null"]}}},
    "validationContext": {
      "type": "object", "additionalProperties": false,
      "required": ["laneId", "policyVersion", "now", "origin", "decisionClass", "envelope", "laneState", "packIndex", "journalState", "routingPolicy", "operatorSession", "packAuthorSessionId", "activeClaims", "activeHolds", "budgetState", "endpointState", "acceptedAmendments", "admittedRevisions", "worktreeSyncRecords", "originalAssignments", "predecessorEvidence", "predecessorCurrentState", "predecessorAcceptanceRecords"],
      "properties": {
        "laneId": {"$ref": "#/$defs/text"}, "policyVersion": {"$ref": "#/$defs/text"}, "now": {"$ref": "#/$defs/date"}, "origin": {"$ref": "#/$defs/text"}, "decisionClass": {"enum": ["M0", "D1", "D2", "D3"]}, "envelope": {"$ref": "#/$defs/envelope"}, "laneState": {"$ref": "#/$defs/laneState"}, "packIndex": {"$ref": "#/$defs/packIndex"}, "journalState": {"$ref": "#/$defs/journal"}, "routingPolicy": {"type": "object", "additionalProperties": false, "required": ["activeEndpointPool"], "properties": {"activeEndpointPool": {"$ref": "#/$defs/strings"}}}, "operatorSession": {"anyOf": [{"$ref": "#/$defs/operator"}, {"type": "null"}]}, "packAuthorSessionId": {"type": ["string", "null"]}, "activeClaims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}, "activeHolds": {"type": "array", "items": {"$ref": "#/$defs/hold"}}, "budgetState": {"$ref": "#/$defs/budget"}, "endpointState": {"type": "array", "items": {"$ref": "#/$defs/endpoint"}}, "acceptedAmendments": {"type": "object", "additionalProperties": {"$ref": "#/$defs/amendment"}}, "admittedRevisions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/revision"}}, "worktreeSyncRecords": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sync"}}, "originalAssignments": {"type": "object", "additionalProperties": {"$ref": "#/$defs/assignment"}}, "predecessorEvidence": {"$ref": "#/$defs/predecessor"}, "predecessorCurrentState": {"$ref": "#/$defs/currentPredecessor"}, "predecessorAcceptanceRecords": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/acceptanceRecord"}}
      }
    }
  }
}
