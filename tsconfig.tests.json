{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "outDir": "./build",
    "rootDir": ".",
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node", "jasmine"]
  },
  "include": [
    "src/**/*",
    "spec/**/*"
  ]
}
